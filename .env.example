# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Web Client ID for Google Identity Services (GIS).
# Obtained from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web application.
# Authorized JavaScript origins to add in Google Cloud Console:
#   - http://localhost:3000 (for local development)
#   - https://<app-id>.run.app (your production Cloud Run URL, or $APP_URL)
# Note: Google Identity Services credential callback flow does not require redirect URIs.
# If left blank, LinguaStep Buddy functions with Guest/Demo mode without errors.
GOOGLE_CLIENT_ID="119764727712-4loaf3h98jv0gvh5d30ngfgs5s3mm1m9.apps.googleusercontent.com"

# AI Usage Budget & Protection Controls:
# USER_DAILY_AI_LIMIT: Maximum live AI queries allowed per user in a 24-hour window (default: 30)
USER_DAILY_AI_LIMIT="30"

# GLOBAL_DAILY_AI_LIMIT: App-wide budget cap across all users per day to protect owner costs (default: 400)
GLOBAL_DAILY_AI_LIMIT="400"

# AI_REQUEST_COOLDOWN_MS: Minimum interval between AI requests per user in milliseconds (default: 1500)
AI_REQUEST_COOLDOWN_MS="1500"
